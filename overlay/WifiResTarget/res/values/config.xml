<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate.

     NOTE: The naming convention is "config_camelCaseValue". Some legacy
     entries do not follow the convention, but all new entries should. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Default access point SSID used for tethering -->
    <string name="wifi_tether_configure_ssid_default" translatable="false">itel VistaTab 30 Pro</string>
    
    <!-- Indicates that 11ax mode is supported on this device. -->
    <bool name="config_wifi11axSupportOverride">true</bool>

    <!-- Keep SAE auto-upgrade disabled for transition-mode AP compatibility. -->
    <bool name="config_wifiSaeUpgradeEnabled">false</bool>
</resources>
